# How the PWA is served: static files, with the API on the same origin.
#
# The proxied origin below comes from the SERVER_ORIGIN environment variable,
# substituted at container start by nginx's own entrypoint (see Dockerfile).
# `$host` and friends are nginx variables and survive it, since only
# SERVER_ORIGIN is in the substitution filter.

server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Covers /api/json/core (JSON:API) and /api/timeline (plain JSON).
    location /api/ {
        proxy_pass ${SERVER_ORIGIN};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
