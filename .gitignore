# moon
.moon/cache
.moon/docker

# Elixir. One set of patterns here covers every Mix project under the repo
# root, so no project needs its own .gitignore.
_build/
deps/
*.ez
erl_crash.dump
.elixir_ls/

# Rust. Build output lands under $HOME/.cache/baalbek-cargo-target/* (see
# pricing/moon.yml), but a plain `cargo build` without that env var falls back
# to an in-tree target/, so it is still ignored. Cargo.lock is NOT ignored —
# committed for the same hermeticity reason core's mix.lock is committed.
target/

# Rustler copies the compiled NIF shared library here at build time
# (pricing_native/priv/native/pricingnative.so); it's a build artefact of
# native/pricingnative's source, not source itself. Unanchored (**/) since
# a mid-pattern slash otherwise anchors the match to the repo root, which
# would only match a nonexistent top-level priv/native/ and silently let
# the real nested pricing_native/priv/native/ path get committed.
**/priv/native/

# Every project's Moon-owned build tree — the artefact its `build`/`package`
# task declares as `outputs` (spec/decisions/adr-0006-task-deps-on-output-declaring-tasks.md).
# Anchored to one directory below the root so it never matches a nested
# build directory a native toolchain owns, such as mobile/android/app/build.
# The Elixir apps compile here rather than into `_build/` so a Moon cache
# restore can never write over the tree Mix and ElixirLS share.
/*/build/

# `server`'s generated OpenAPI spec, written by `server:openapi`. The source
# of truth is the Ash/AshJsonApi resource declarations it is introspected
# from, not this artefact.
server/priv/static/

# Assembled releases, written by `server:release`. Kept out of every
# project's own directory so no `project://` input walks a 101 MB tree
# while `mix release --overwrite` is rewriting it; dot-prefixed so
# .moon/workspace.yml's `globs: ["*"]` doesn't turn it into a project.
.artifacts/

# TypeScript. pnpm-lock.yaml is NOT ignored, for the same hermeticity reason
# mix.lock and Cargo.lock are not.
node_modules/
.pnpm-store/
dist/
*.tsbuildinfo

# Playwright's HTML report, written by the CI reporter. Traces and
# the browser binaries both live under ~/.cache, outside the repo — see
# e2e/playwright.config.ts's outputDir.
e2e/playwright-report/

# core-api-client's one generated artifact (moon.yml's `build` task,
# openapi-typescript from server's OpenAPI spec) — same rationale as
# server/priv/static/ above, the source of truth is server's Ash/AshJsonApi
# resources, not this file.
core-api-client/src/generated/

# The explorer's model, written by `explorer:generate` from the moon graph,
# git history and capabilities.yml. Committing it would let the site drift
# from the workspace it describes.
explorer/src/generated/

# moon-elixir-plugin writes its WASM artifact beside the committed one and
# renames over it, so a failed compile leaves the loadable file intact.
moon-elixir-plugin/plugin/*.wasm.new
