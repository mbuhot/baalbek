# Erlang is held at 28.4.3, one release behind: proto's asdf backend resolves
# only strict x.y.z versions, and the 28.5 family ships a bare "28.5" tag with
# four-component hotfixes and no "28.5.0", so none of it resolves.
moon           = "2"
node           = "26.7.0"
pnpm           = "11.9.0"
rust           = "stable"
"asdf:erlang"  = "28.4.3"
"asdf:elixir"  = "1.20.2"
"asdf:gleam"   = "1.13"
# Gleam shells out to rebar3 to build a dependency's Erlang-native code.
"asdf:rebar"   = "3.27.0"

# JDK 21 for Gradle: Capacitor's Android library compiles at
# JavaVersion.VERSION_21, so javac needs at least that. The Android
# SDK and build-tools stay OS-level, because no proto plugin covers them.
java           = "temurin-21.0.12+8"
